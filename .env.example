# ==============================================================================
# Direct Mail Server & MongoDB Job Queue Configuration (.env)
# ==============================================================================

# REST API Port (default: 3000)
PORT=3000

# Secret API Password for authentication (-H "x-api-key: ar@51/er")
API_PASSWORD=ar@51/er

# MongoDB Connection String (stores outbound jobs, retry history, and inbound emails)
# If using the included Docker Compose MongoDB service: mongodb://127.0.0.1:27017/mailserver
# Or point to your external/Atlas cluster: mongodb+srv://user:pass@cluster.mongodb.net/mailserver
MONGODB_URI=mongodb://127.0.0.1:27017/mailserver

# Outbound HELO/EHLO Hostname (should match your VPS Reverse DNS / PTR)
HELO_HOST=mail.exauraa.com

# Inbound SMTP Receiver Port (default: 25)
INBOUND_PORT=25

# Parallel Outbound Delivery Concurrency
CONCURRENCY=25
