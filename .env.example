# ==============================================================================
# Direct Mail Server & MongoDB Job Queue Configuration (.env)
# ==============================================================================

# REST API Port (default: 3000)
PORT=3000

# Secret API Password for authentication (-H "x-api-key: ar@51/er")
API_PASSWORD=ar@51/er

# ==============================================================================
# MongoDB Database Modes (2 Modes: 'local' or 'remote')
# ==============================================================================
# MONGO_MODE: 'local' (default) or 'remote'
MONGO_MODE=local

# Local MongoDB URI (Used when MONGO_MODE=local)
# Connects to the local MongoDB 7 container included in docker-compose.yml
MONGO_LOCAL_URI=mongodb://127.0.0.1:27017/mailserver

# Remote MongoDB URI (Used when MONGO_MODE=remote)
# Connects to MongoDB Atlas or an external managed MongoDB cluster
MONGO_REMOTE_URI=mongodb+srv://username:password@cluster.mongodb.net/mailserver?retryWrites=true&w=majority

# ==============================================================================
# Outbound & Inbound SMTP Settings
# ==============================================================================
# Outbound HELO/EHLO Hostname (should match your VPS Reverse DNS / PTR)
HELO_HOST=mail.exauraa.com

# Inbound SMTP Receiver Port (default: 25)
INBOUND_PORT=25

# Parallel Outbound Delivery Concurrency
CONCURRENCY=25
