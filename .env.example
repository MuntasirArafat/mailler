# ==============================================================================
# Mail Server Docker Environment Configuration (.env)
# ==============================================================================

# REST API Port (default: 3000)
PORT=3000

# Inbound SMTP Receiver Port (default: 25)
INBOUND_PORT=25

# Outbound HELO/EHLO Hostname (should match your VPS Reverse DNS / PTR)
HELO_HOST=mail.exauraa.com

# Secret API Password used for authenticating all requests
# Provide this in the header: -H "x-api-key: ar@51/er"
API_PASSWORD=ar@51/er

# Inbound Mail Webhook Callback URL
# When an incoming email arrives on Port 25, the server parses it and immediately
# POSTs the complete JSON payload (from, to, subject, bodies, attachments) here.
WEBHOOK_URL=

# Outbound delivery concurrency
CONCURRENCY=25
